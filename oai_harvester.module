<?php

/**
 * @file
 * User-facing integration hooks for the OAI-PMH harvester.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Url;

/**
 * Implements hook_cron().
 */
function oai_harvester_cron(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('islandora_oai_source');
  $now = \Drupal::time()->getRequestTime();
  $intervals = ['hourly' => 3600, 'daily' => 86400, 'weekly' => 604800];
  foreach ($storage->loadMultiple() as $source) {
    $settings = $source->toRuntimeConfig();
    if (!$source->status() || $settings['frequency'] === 'manual') {
      continue;
    }
    $last = \Drupal::database()->select('islandora_oai_harvest_run', 'r')
      ->fields('r', ['completed'])
      ->condition('source_id', $source->id())
      ->condition('state', ['completed', 'completed_with_warnings'], 'IN')
      ->condition('failed_count', 0)
      ->orderBy('completed', 'DESC')->range(0, 1)->execute()->fetchField();
    $due = (int) $last + ($intervals[$settings['frequency']] ?? 86400);
    if ($due <= $now) {
      \Drupal::service('oai_harvester.run_manager')->start($source, 'incremental');
    }
  }
}

/**
 * Implements hook_entity_view().
 */
function oai_harvester_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode): void {
  if ($entity->getEntityTypeId() !== 'node' || !\Drupal::currentUser()->hasPermission('view islandora oai history')) {
    return;
  }
  $record = \Drupal::database()->select('islandora_oai_record', 'r')
    ->fields('r')
    ->condition('node_id', (int) $entity->id())
    ->execute()->fetchAssoc();
  if (!$record) {
    return;
  }
  $source = \Drupal::entityTypeManager()->getStorage('islandora_oai_source')->load($record['source_id']);
  $rows = [
    [t('Source'), $source ? $source->label() : $record['source_id']],
    [t('OAI identifier'), $record['oai_identifier']],
    [t('Source datestamp'), $record['source_datestamp'] ?: t('Unknown')],
    [t('Last synchronized'), $record['last_sync'] ? date('Y-m-d H:i:s T', (int) $record['last_sync']) : t('Never')],
    [t('Synchronization status'), $record['sync_status']],
  ];
  $links = [];
  if ($record['last_run_id']) {
    $links[] = ['#type' => 'link', '#title' => t('View harvest run'), '#url' => Url::fromRoute('oai_harvester.run', ['run_id' => $record['last_run_id']])];
  }
  if ($record['raw_id'] && \Drupal::currentUser()->hasPermission('view islandora oai raw metadata')) {
    $links[] = ['#type' => 'link', '#title' => t('View source metadata'), '#url' => Url::fromRoute('oai_harvester.raw', ['raw_id' => $record['raw_id']])];
  }
  if (\Drupal::currentUser()->hasPermission('retry islandora oai records')) {
    $links[] = ['#type' => 'link', '#title' => t('Re-harvest this record'), '#url' => Url::fromRoute('oai_harvester.record_reharvest', ['node' => $entity->id()])];
  }
  $build['islandora_oai_harvest'] = [
    '#type' => 'details',
    '#title' => t('Harvest information'),
    '#open' => FALSE,
    '#weight' => 100,
    'warning' => ['#markup' => '<p>' . t('Externally managed mapped fields may be overwritten by the next synchronization.') . '</p>'],
    'table' => ['#type' => 'table', '#rows' => $rows],
    'links' => ['#theme' => 'item_list', '#items' => $links],
    '#cache' => ['contexts' => ['user.permissions'], 'tags' => $entity->getCacheTags(), 'max-age' => 0],
  ];
}
